# ============================================
# Species Atlas - 环境变量配置示例
# 复制此文件为 .env 并修改配置
# ============================================

# 版本号
VERSION=1.0.0

# ==========================================
# MySQL 配置
# ==========================================
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=species_atlas
MYSQL_USER=species
MYSQL_PASSWORD=your_password_here
MYSQL_PORT=3306

# ==========================================
# 后端服务配置
# ==========================================
SERVER_PORT=8080

# JWT 密钥（生产环境必须修改！至少 64 个字符）
# 可以使用以下命令生成随机密钥：
# Linux/Mac: openssl rand -base64 64 | tr -d '\n'
# PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=your-super-secret-jwt-key-should-be-at-least-64-characters-long-for-production-use

# ==========================================
# 前端服务配置
# ==========================================
WEB_PORT=80
